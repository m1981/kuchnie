#!/usr/bin/env sh

# 1. PurgeCSS runs on EVERYTHING (no lint-staged)
echo "🧹 1/3: Cleaning up unused CSS (Whole Repo)..."
pnpm exec purgecss --config ./purgecss.config.js
git add common.css

# 2. Root-level formatting (html, css, js, md)
echo "💅 2/3: Formatting staged root files with Prettier..."
pnpm exec lint-staged

# 3. Kitchen-agent frontend (Svelte + TypeScript)
if git diff --cached --name-only | grep -q '^kitchen-agent/frontend/'; then
	echo "🔧 3/3: Linting & formatting kitchen-agent/frontend..."
	cd kitchen-agent/frontend && npx lint-staged
fi