#!/usr/bin/env sh

# Pre-commit hook: VERIFICATION ONLY
# ====================================
# This hook verifies code style on STAGED FILES ONLY.
# If checks fail, run the fix commands manually before committing.
#
# Commands to fix:
#   pnpm format                    # Fix root formatting
#   cd kitchen-agent/frontend && pnpm format && pnpm lint:fix  # Fix frontend

set -e

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo "No files staged for commit."
    exit 0
fi

echo "📋 Staged files:"
echo "$STAGED_FILES" | head -10
if [ $(echo "$STAGED_FILES" | wc -l) -gt 10 ]; then
    echo "... and $(( $(echo "$STAGED_FILES" | wc -l) - 10 )) more"
fi
echo ""

# 1. Check Prettier on staged files (root level: html, css, js, md)
ROOT_FILES=$(echo "$STAGED_FILES" | grep -v '^kitchen-agent/' | grep -E '\.(html|css|js|md)$' || true)
if [ -n "$ROOT_FILES" ]; then
    echo "🧹 1/3: Verifying Prettier (root files)..."
    echo "$ROOT_FILES" | xargs pnpm exec prettier --check || {
        echo ""
        echo "❌ Root files have formatting issues."
        echo "   Run: pnpm format"
        echo ""
        exit 1
    }
else
    echo "⏭️  1/3: No root files to check"
fi

# 2. PurgeCSS (only if common.css exists)
if [ -f "common.css" ]; then
    echo "🔍 2/3: Verifying PurgeCSS config..."
    pnpm exec purgecss --config ./purgecss.config.js > /dev/null 2>&1 || {
        echo ""
        echo "❌ PurgeCSS failed."
        echo "   Check purgecss.config.js"
        echo ""
        exit 1
    }
else
    echo "⏭️  2/3: No common.css, skipping PurgeCSS"
fi

# 3. Kitchen-agent frontend (Svelte + TypeScript)
FRONTEND_FILES=$(echo "$STAGED_FILES" | grep '^kitchen-agent/frontend/' || true)
if [ -n "$FRONTEND_FILES" ]; then
    echo "🔧 3/3: Verifying frontend (Prettier + ESLint)..."
    cd kitchen-agent/frontend

    # Get relative paths for frontend files
    FRONTEND_REL=$(echo "$FRONTEND_FILES" | sed 's|^kitchen-agent/frontend/||')

    # Check Prettier on staged frontend files
    echo "$FRONTEND_REL" | xargs npx prettier --check || {
        echo ""
        echo "❌ Frontend files have formatting issues."
        echo "   Run: cd kitchen-agent/frontend && pnpm format"
        echo ""
        exit 1
    }

    # Check ESLint on staged frontend files (only .ts, .js, .svelte)
    ESLINT_FILES=$(echo "$FRONTEND_REL" | grep -E '\.(ts|js|svelte)$' || true)
    if [ -n "$ESLINT_FILES" ]; then
        echo "$ESLINT_FILES" | xargs npx eslint || {
            echo ""
            echo "❌ Frontend has ESLint errors."
            echo "   Run: cd kitchen-agent/frontend && pnpm lint:fix"
            echo ""
            exit 1
        }
    fi
else
    echo "⏭️  3/3: No frontend changes, skipping..."
fi

echo ""
echo "✅ All style checks passed!"
