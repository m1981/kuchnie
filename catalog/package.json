{
  "name": "catalog",
  "version": "0.1.0",
  "description": "Material catalog browser — YAML → JSON → Vite",
  "private": true,
  "scripts": {
    "dev": "node dev.js",
    "build": "cd .. && node data/materials/build.js",
    "test": "cd .. && node --test data/materials/tests/validate.test.js",
    "validate": "cd .. && node data/materials/build.js && node --test data/materials/tests/validate.test.js",
    "preview": "cd .. && npx vite preview --config catalog/vite.config.mjs"
  },
  "dependencies": {
    "js-yaml": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vite": "^8.1.0"
  }
}
