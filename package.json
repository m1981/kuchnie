{
    "name": "duo-draft",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "node --test data/materials/tests/validate.test.js",
        "materials:build": "node data/materials/build.js",
        "materials:validate": "node data/materials/build.js && node --test data/materials/tests/validate.test.js",
        "catalog:dev": "node catalog/dev.js",
        "catalog:build": "node data/materials/build.js && npx vite build --config catalog/vite.config.mjs",
        "prepare": "husky",
        "format": "prettier --write .",
        "verify": "prettier --check .",
        "fix-all": "prettier --write . && cd kitchen-agent/frontend && pnpm format && pnpm lint:fix"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "packageManager": "pnpm@10.4.1",
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.3",
        "purgecss": "^8.0.0",
        "vite": "^8.1.0"
    },
    "lint-staged": {
        "*.{html,css,js,md}": "prettier --write"
    },
    "dependencies": {
        "highlight.js": "^11.11.1",
        "js-yaml": "^5.1.0",
        "marked": "^18.0.4",
        "marked-highlight": "^2.2.4",
        "mermaid": "^11.15.0",
        "prettier-plugin-svelte": "^4.0.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "zod": "^4.4.3"
    }
}
